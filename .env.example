# Required. An Algrow API key with the "generations" scope: https://algrow.online/settings
ALGROW_API_KEY=
ALGROW_API_BASE=https://api.algrow.online

# Which LLM writes the beats (the "plan" stage). Pick one:
#   claude-cli  uses the `claude` command if you have Claude Code installed (default when present)
#   openai      any OpenAI-compatible chat API: OpenAI, Gemini, Groq, Ollama, OpenRouter...
#   manual      writes the prompt to a file, you paste it into any chat model and save the answer
PLANNER=claude-cli
# For PLANNER=openai:
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
PLANNER_MODEL=

